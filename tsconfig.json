{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "paths": { "styled-system/*": ["./styled-system/*"] }
  },
  "include": ["src", "styled-system"]
}
