{
  "name": "tsgo-memory-repro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Repro: tsgo (TS7 native) materializes more types/instantiations and uses more peak memory than tsc (TS6) on the same React/React-Query/Zod code.",
  "scripts": {
    "gen": "node generate.mjs",
    "diag:ts6": "tsc -p tsconfig.json --extendedDiagnostics",
    "diag:ts7": "tsgo -p tsconfig.json --extendedDiagnostics"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.65.1",
    "@types/react": "^18.3.27",
    "react": "^18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "typescript": "6.0.3"
  }
}
