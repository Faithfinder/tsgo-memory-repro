{
  "name": "tsgo-memory-repro",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Repro: tsgo (TS7 native) instantiates ~2x more types than tsc (TS6) on Panda CSS code, with a robust peak-RSS gap.",
  "scripts": {
    "setup": "panda codegen",
    "gen": "node pandagen.mjs",
    "diag:ts6": "tsc -p tsconfig.json --extendedDiagnostics",
    "diag:ts7": "tsgo -p tsconfig.json --extendedDiagnostics"
  },
  "dependencies": {
    "@types/react": "18.3.30",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@pandacss/dev": "1.11.2",
    "@typescript/native-preview": "7.0.0-dev.20260604.1",
    "typescript": "6.0.3"
  }
}
